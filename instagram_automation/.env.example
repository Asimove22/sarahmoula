# ─────────────────────────────────────────────────────────────
# Meta / Instagram Graph API Credentials
# Copie ce fichier en .env et remplis tes valeurs réelles
# NE JAMAIS committer le fichier .env dans git
# ─────────────────────────────────────────────────────────────

# Depuis Meta for Developers > ton App > Paramètres de base
APP_ID=your_app_id_here
APP_SECRET=your_app_secret_here

# Token long-terme (60 jours) ou token permanent via système OAuth
ACCESS_TOKEN=your_long_lived_access_token_here

# ID de ton compte Instagram Business
# Obtenu via : GET /me/accounts puis GET /{page_id}?fields=instagram_business_account
IG_USER_ID=your_instagram_user_id_here

# Version de l'API Graph (ne pas modifier sauf mise à jour majeure)
API_VERSION=v21.0

# Optionnel : URL de base (ne pas modifier)
BASE_URL=https://graph.facebook.com
