{
  "name": "contrats-app",
  "private": true,
  "version": "1.0.0",
  "description": "Gestion contractuelle et documentaire (NEC3/NEC4, contrats français) – usage personnel, local",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "npm run build && npm run serve",
    "serve": "node --disable-warning=ExperimentalWarning server/index.js",
    "build": "vite build",
    "dev": "vite",
    "dev:server": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test server/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@kenjiuno/msgreader": "^1.29.0",
    "docx": "9.9.0",
    "exceljs": "4.4.0",
    "express": "^5.1.0",
    "fast-xml-parser": "5.11.2",
    "mailparser": "^3.12.4",
    "mammoth": "1.13.0",
    "multer": "^2.0.2",
    "unpdf": "1.8.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "lucide-react": "^1.17.0",
    "postcss": "^8.5.15",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.9.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.0.12"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
